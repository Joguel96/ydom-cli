div:
  (class="hero")
  div:
    (class="logo-wrapper")
    img:
      (class="logo" src="/favicon.svg" alt="YDOM Logo")
  span:
    (class="badge")
    "◈ YDOM Library"
  h1:
    (class="title")
    "Build Reactive UIs"
  p:
    (class="subtitle")
    "Un motor reactivo ultraligero basado en señales y Web Components nativos. Sin magia oculta, solo JavaScript puro con superpoderes."
  div:
    (class="counter-card")
    span:
      (class="counter-label")
      "Contador Reactivo"
    span:
      (class="counter-value")
      "{{ count }}"
    div:
      (class="counter-actions")
      button:
        (class="btn btn-ghost" @click="decrement")
        "−"
      button:
        (class="btn btn-primary" @click="increment")
        "+"
      button:
        (class="btn btn-ghost" @click="reset")
        "↺"
  div:
    (class="links")
    a:
      (class="link" href="https://github.com/Joguel96/ydom-core" target="_blank" rel="noopener")
      "GitHub"
    a:
      (class="link" href="https://github.com/Joguel96/ydom-core#readme" target="_blank" rel="noopener")
      "Documentación"